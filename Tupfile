CXXFLAGS = -g -std=c++20
CXX = c++
: foreach *.cc |> $(CXX) $(CXXFLAGS) -c %f -o %o |> %B.o {objs}
: foreach test/*.cc |> $(CXX) $(CXXFLAGS) -c %f -o %o |> test/%B.o {test_objs}
: foreach linux/*.cc |> $(CXX) $(CXXFLAGS) -c %f -o %o |> linux/%B.o {linux_objs}
: {objs} {test_objs} |> $(CXX) $(CXXFLAGS) %f -lspdlog -lfmt -lpthread -lgtest -o %o |> test/jamb
: {objs} {linux_objs} |> $(CXX) $(CXXFLAGS) %f -lspdlog -lfmt -lpthread -lasound -o %o |> linux/jamb
