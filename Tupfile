## For building on linux

GTEST = /usr/src/googletest/googletest
CXX = c++
CXXFLAGS = -g -std=c++20 -I$(GTEST)/include -Igenerated
LIBS = -lgtest -lasound -lfmt -lpthread -lyaml-cpp

# clang has better errors but isn't installed by default
#CXX = clang++

!compile = |> $(CXX) $(CXXFLAGS) -c %f -o %o |>
!link = |> $(CXX) $(CXXFLAGS) %f $(LIBS) -o %o |>


: |> mkdir -p gtest; ln -s $(GTEST)/src/gtest-all.cc gtest |> gtest/gtest-all.cc
: gtest/gtest-all.cc |> !compile -I$(GTEST) |> gtest/gtest-all.o {test_objs}
: |> bash codegen-defaultConfig.sh > %o |> generated/Launchpad-defaultConfig.hh {gen}

: foreach *.cc                        ^\._ | {gen} |> !compile |> %B.o {objs}
: foreach test/*.cc                   ^\._ | {gen} |> !compile |> test/%B.o {test_objs}
: foreach linux/*.cc                  ^\._ | {gen} |> !compile |> linux/%B.o {linux_objs}
: {objs} {test_objs}                  ^\._         |> !link    |> test/jamb
: {objs} {linux_objs} test/FakeMidi.o ^\._         |> !link    |> linux/jamb

# NB Files starting with ._ are artifacts of sshfs and can't be compiled
