CXXFLAGS = -g -std=c++20
CXX = clang++
: foreach *.cc         ^\._ |> $(CXX) $(CXXFLAGS) -c %f -o %o |> %B.o {objs}
: foreach test/*.cc    ^\._ |> $(CXX) $(CXXFLAGS) -c %f -o %o |> test/%B.o {test_objs}
: foreach linux/*.cc   ^\._ |> $(CXX) $(CXXFLAGS) -c %f -o %o |> linux/%B.o {linux_objs}
: {objs} {test_objs}   ^\._ |> $(CXX) $(CXXFLAGS) %f -lspdlog -lfmt -lpthread -lgtest -o %o |> test/jamb
: {objs} {linux_objs}  ^\._ |> $(CXX) $(CXXFLAGS) %f -lspdlog -lfmt -lpthread -lasound -o %o |> linux/jamb
